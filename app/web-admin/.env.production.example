# ─────────────────────────────────────────────────────────────────────────
# Afrizone web-admin — production build-time env vars for Cloudflare Pages
# Set these in Pages → your project → Settings → Environment variables
# (Production environment). Vite bakes them into the build, so a change
# requires a rebuild/redeploy, not just a server restart.
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED. The deployed API's origin (no trailing slash, no /api suffix).
VITE_API_URL=https://api.afrizoneparttime.com

# Optional — only needed if Google SSO is enabled on the API
# (must match one of the GOOGLE_*_CLIENT_ID values set there).
VITE_GOOGLE_CLIENT_ID=
