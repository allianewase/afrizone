// Afrizone Part Time: Prisma schema
//
// Production target: Cloudflare D1 (SQLite-based), via the @prisma/adapter-d1
// driver adapter - see src/prisma.ts. Local dev also runs on SQLite (DATABASE_URL),
// so this schema needs no changes between the two; only the Prisma Client
// instantiation differs (adapter-bound vs a plain DATABASE_URL connection).
//
// Prisma Migrate does not support D1 yet, so schema changes are applied via:
//   npx prisma migrate diff --from-empty --to-schema ./prisma/schema.prisma \
//     --script --output migrations/000X_name.sql
//   npx wrangler d1 migrations apply <db-name> --local   (or --remote)
// rather than `prisma migrate dev`/`db push` for the D1 database itself.
// Local SQLite dev (DATABASE_URL) keeps using `prisma db push` as before.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE ON ENUMS: SQLite does not support native enums, so enum-typed columns
// are stored as `String`. The allowed values live as TS union types in
// src/types.ts and are validated in the route handlers. On Postgres these can
// become real `enum` blocks.
//
// NOTE ON `tiers`: SQLite does not support scalar lists (`Tier[]`), so a
// worker's tiers are stored as a single comma-separated String (e.g.
// "PROMO,DISPATCH"). The API always exposes `tiers` as a real string[] array.
// Helpers tiersToString / tiersToArray in src/types.ts do the conversion.

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  phone             String?  @unique // worker OTP login (E.164, e.g. +2348030000001)
  passwordHash      String? // nullable: workers are passwordless (phone OTP)
  totpSecret        String? // pending or active TOTP secret (RFC 6238)
  totpEnabled       Boolean  @default(false)
  googleId          String?  @unique // Google SSO subject (admin)
  role              String   @default("WORKER") // Role enum
  tiers             String   @default("") // comma-separated Tier[]: see note above
  kycStatus         String   @default("PENDING") // KycStatus enum
  kycNote           String? // latest verification note (auto-reject reason from Smile ID, or admin note)
  location          String?
  rating            Float?
  completedCount    Int      @default(0)
  bankMasked        String?
  bankAccountNumber String? // real payout account (NUBAN): required for live Paystack transfers
  bankCode          String? // Paystack bank code, e.g. "058" (GTBank)
  bankName          String?
  tin               String? // Tax Identification Number: stored from KYC / profile edit
  pushToken         String? // Expo push token (ExponentPushToken[...]): updated on each login
  notifTasks        Boolean  @default(true) // push: task matches & approval status changes
  notifPay          Boolean  @default(true) // push: payment releases & withdrawal updates
  notifEmail        Boolean  @default(false) // email summary digest (future)
  createdAt         DateTime @default(now())

  tasksCreated      Task[]            @relation("TaskCreatedBy")
  applications      Application[]
  timesheets        Timesheet[]
  payments          Payment[]
  auditLogs         AuditLog[]
  clockEvents       ClockEvent[]
  withdrawals       Withdrawal[]
  fundingsInitiated Funding[]
  contracts         Contract[]
  passwordResets    PasswordReset[]
  kycDocuments      KycDocument[]
  kycVerifications  KycVerification[]
  disputes          Dispute[]
  ratingsReceived   Rating[]          @relation("WorkerRatings")
  ratingsGiven      Rating[]          @relation("RatingsGiven")
  notifications     Notification[]
}

model Task {
  id             String   @id @default(cuid())
  title          String
  description    String
  category       String
  tier           String // Tier enum
  payModel       String // PayModel enum (HOURLY | FIXED)
  rate           Int? // ₦/hour for HOURLY
  budget         Int? // fixed ₦ for FIXED
  startDate      DateTime
  endDate        DateTime
  locationType   String // LocationType enum (PHYSICAL | REMOTE)
  address        String?
  lat            Float? // task site latitude : required for real geofence check
  lng            Float? // task site longitude: required for real geofence check
  geofenceRadius Int      @default(100)
  slots          Int
  status         String   @default("OPEN") // TaskStatus enum
  deadline       DateTime
  createdById    String
  createdAt      DateTime @default(now())

  createdBy    User          @relation("TaskCreatedBy", fields: [createdById], references: [id])
  applications Application[]
  timesheets   Timesheet[]
  payments     Payment[]
  clockEvents  ClockEvent[]
  contracts    Contract[]
  ratings      Rating[]

  @@index([status])
}

model Application {
  id        String   @id @default(cuid())
  taskId    String
  workerId  String
  pitch     String?
  status    String   @default("APPLIED") // AppStatus enum
  reason    String?
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id])
  worker User @relation(fields: [workerId], references: [id])

  @@index([taskId, status])
  @@index([workerId, status])
  @@index([taskId, workerId])
}

model Timesheet {
  id          String   @id @default(cuid())
  taskId      String
  workerId    String
  periodStart DateTime
  periodEnd   DateTime
  hours       Float
  status      String   @default("SUBMITTED") // TimesheetStatus enum
  gpsNote     String?
  createdAt   DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id])
  worker User @relation(fields: [workerId], references: [id])

  @@index([status])
  @@index([workerId])
}

model Payment {
  id        String   @id @default(cuid())
  workerId  String
  taskId    String
  gross     Int
  whtRate   Float    @default(0.05)
  whtAmount Int
  net       Int
  status    String   @default("PENDING") // PaymentStatus enum
  createdAt DateTime @default(now())

  worker User @relation(fields: [workerId], references: [id])
  task   Task @relation(fields: [taskId], references: [id])

  @@index([status])
  @@index([workerId])
}

model AuditLog {
  id        String   @id @default(cuid())
  // Nullable: an automated actor has no User row. actorId was REQUIRED and
  // FK'd to User, so any system-initiated action failed its audit insert
  // outright - which blocks every webhook, scheduled job and integration in
  // the roadmap from being auditable at all.
  actorId   String?
  actorType String   @default("USER") // ActorType: USER | SYSTEM | WEBHOOK | JOB | INTEGRATION
  actorRef  String? // identifies a non-USER actor, e.g. "paystack"
  action    String
  entity    String
  entityId  String
  meta      String? // JSON serialized as String (SQLite has no Json type)
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId])
}

// ── v2: Hiring ────────────────────────────────────────────────────────────────

model Job {
  id             String   @id @default(cuid())
  title          String
  department     String
  location       String
  employmentType String // EmploymentType enum (FULL_TIME | PART_TIME | CONTRACT)
  salaryMin      Int?
  salaryMax      Int?
  description    String
  needsCv        Boolean  @default(true)
  needsCover     Boolean  @default(false)
  needsPortfolio Boolean  @default(false)
  closingDate    DateTime
  status         String   @default("OPEN") // JobStatus enum (OPEN | CLOSED)
  createdById    String
  createdAt      DateTime @default(now())

  candidates JobApplication[]
}

model JobApplication {
  id        String   @id @default(cuid())
  jobId     String
  name      String
  email     String
  phone     String?
  stage     String   @default("SCREENING") // Stage enum
  cvNote    String?
  rating    Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id])
}

// ── v2: Settings ──────────────────────────────────────────────────────────────

model TaxRate {
  id           String  @id @default(cuid())
  jurisdiction String // e.g. "Federal", "Lagos"
  category     String // e.g. "Services", "default"
  whtRate      Float
  vatRate      Float
  active       Boolean @default(true)
}

model Category {
  id              String  @id @default(cuid())
  name            String
  tier            String // Tier enum
  defaultPayModel String // PayModel enum (HOURLY | FIXED)
  active          Boolean @default(true)
}

model Setting {
  key   String @id @unique
  value String // String/JSON value
}

// ── v3: Worker-facing (mobile app) ──────────────────────────────────────────

model ClockEvent {
  id          String   @id @default(cuid())
  workerId    String
  taskId      String
  type        String // ClockType enum (IN | OUT)
  lat         Float?
  lng         Float?
  withinFence Boolean
  note        String?
  createdAt   DateTime @default(now())

  worker User @relation(fields: [workerId], references: [id])
  task   Task @relation(fields: [taskId], references: [id])

  @@index([workerId, taskId, createdAt])
}

model Withdrawal {
  id            String   @id @default(cuid())
  workerId      String
  amount        Int
  bankMasked    String
  status        String   @default("PROCESSING") // WithdrawalStatus enum (PROCESSING | PAID | FAILED)
  provider      String? // "paystack" | "simulated"
  reference     String?  @unique // our idempotency key, also sent to Paystack
  providerRef   String? // Paystack transfer_code
  failureReason String?
  createdAt     DateTime @default(now())

  worker User @relation(fields: [workerId], references: [id])
}

// Platform-level inbound funding (Afrizone Mart topping up the balance that
// worker withdrawals draw from). Mirrors Withdrawal's shape/lifecycle. The
// running platform balance is derived (Σ SUCCESS fundings − Σ non-failed
// withdrawals), not stored: same "derive, don't store" convention as the
// per-worker wallet in wallet.ts.
model Funding {
  id          String   @id @default(cuid())
  amount      Int
  status      String   @default("PENDING") // FundingStatus enum (PENDING | SUCCESS | FAILED)
  provider    String? // "paystack" | "simulated"
  reference   String   @unique // our idempotency key, also sent to Paystack
  providerRef String? // Paystack transaction access_code
  initiatedBy String
  createdAt   DateTime @default(now())

  admin User @relation(fields: [initiatedBy], references: [id])
}

model Contract {
  id            String    @id @default(cuid())
  taskId        String
  workerId      String
  status        String    @default("PENDING_SIGNATURE") // ContractStatus enum (PENDING_SIGNATURE | SIGNED)
  signedAt      DateTime?
  signerName    String? // typed full-name signature, captured at sign time (record of intent)
  signerIp      String? // requesting IP at sign time
  signatureHash String? // SHA-256 of `${contractId}:${workerId}:${signerName}:${signedAt.toISOString()}`, for tamper-evidence
  createdAt     DateTime  @default(now())

  task   Task @relation(fields: [taskId], references: [id])
  worker User @relation(fields: [workerId], references: [id])

  @@index([taskId, workerId])
  @@index([workerId])
}

// ── Auth: phone OTP + password reset (hashed at rest, single-use, time-boxed) ──

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  // HMAC-SHA256(server pepper, "salt:phone:purpose:code") - see routes/authOtp.ts.
  // Was an unsalted sha256 of the six digits alone, which is reversible by
  // anyone who can read this table: 10^6 values precompute to a few megabytes.
  codeHash   String
  // Per-row random salt. Nullable only so the column could be added without a
  // backfill; rows written since always carry one, and a row without one can no
  // longer be verified against (its digest scheme no longer exists).
  codeSalt   String?
  purpose    String    @default("login") // OtpPurpose enum (login)
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String // sha256 of the reset token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Rating {
  id          String   @id @default(cuid())
  workerId    String
  taskId      String
  score       Int // 1–5 stars
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  worker    User @relation("WorkerRatings", fields: [workerId], references: [id])
  task      Task @relation(fields: [taskId], references: [id])
  createdBy User @relation("RatingsGiven", fields: [createdById], references: [id])

  @@unique([workerId, taskId]) // one rating per worker per task
  @@index([workerId])
}

model Dispute {
  id          String   @id @default(cuid())
  workerId    String
  entityType  String // PAYMENT | TIMESHEET
  entityId    String
  reason      String
  status      String   @default("OPEN") // DisputeStatus: OPEN | RESOLVED | CLOSED
  resolution  String? // admin note when resolving / closing
  // Status of the disputed Payment/Timesheet at the moment the dispute was
  // raised, so closing the dispute restores it instead of guessing. Nullable
  // for rows created before this column existed - those fall back to APPROVED,
  // the old hard-coded behaviour.
  priorStatus String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  worker User @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@index([entityId])
}

model KycDocument {
  id           String   @id @default(cuid())
  userId       String
  docType      String // "ID" | "SELFIE" | "DOCS"
  filename     String // stored filename on disk
  originalName String?
  mimeType     String?
  path         String // absolute path on disk
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model KycVerification {
  id         String   @id @default(cuid())
  workerId   String
  jobId      String   @unique // our id, sent to Smile as partner_params.job_id
  smileJobId String? // Smile's SmileJobID, once assigned
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED | ERROR
  resultCode String?
  resultText String?
  raw        String? // JSON of the last Smile ID response, for audit/debugging
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  worker User @relation(fields: [workerId], references: [id])

  @@index([workerId])
}

// ── In-app notification inbox ─────────────────────────────────────────────────

// The DURABLE record of everything the platform tells a worker. Push delivery
// is best-effort and silently fails - a worker who declined the notification
// permission once received nothing, forever, and nobody found out. Since these
// messages now include things that cost a worker money or standing (a rejected
// credential, an application decision, a released payment), the record has to
// exist independently of whether a push ever arrived.
//
// Written by notifyWorker/notifyWorkers in services/push.ts, which every
// notifying route already goes through - so the record is created at the same
// single choke point rather than at each call site.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  // The deep-link payload, e.g. {"screen":"wallet"}. JSON serialised as a
  // String, as elsewhere in this schema - SQLite has no Json type.
  data      String?
  readAt    DateTime? // null = unread
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  // The inbox list: one worker's notifications, newest first.
  @@index([userId, createdAt])
  // The unread badge, which is polled far more often than the list is opened.
  @@index([userId, readAt])
}
