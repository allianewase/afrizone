PORT=4000
JWT_SECRET=dev-secret-change-me
# SQLite (default, zero-install):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production) — also switch provider in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@localhost:5432/afrizone?schema=public"

# Paystack payouts — blank = SIMULATED mode (no real transfers).
# Add your secret key to enable live Paystack transfers on withdrawals.
PAYSTACK_SECRET=
PAYSTACK_BASE=https://api.paystack.co

# SMS (worker OTP) — blank = sim mode (devCode returned, master 123456 in dev)
SMS_PROVIDER=          # termii | twilio | (blank)
TERMII_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Google SSO (admin web + worker mobile) — blank = SSO disabled (button shows a
# clear message, POST /api/auth/google returns 503). The backend must list EVERY
# OAuth client id used by any app as an allowed audience, because each app's
# token carries a different `aud`:
#   GOOGLE_WEB_CLIENT_ID     -> web-admin (browser) + backend audience
#   GOOGLE_IOS_CLIENT_ID     -> mobile on iOS
#   GOOGLE_ANDROID_CLIENT_ID -> mobile on Android
#   GOOGLE_EXPO_CLIENT_ID    -> mobile via Expo Go / web (expo-auth-session)
# See ../GOOGLE_SETUP.md for which Client ID goes where.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_EXPO_CLIENT_ID=
# GOOGLE_CLIENT_ID still works as an alias for the web client id (back-compat).
# GOOGLE_CLIENT_ID=
# Optional: comma-separated list of any additional allowed audiences.
# GOOGLE_CLIENT_IDS=
# Email (password reset / OTP email) — blank = devToken returned, link logged
SMTP_URL=
