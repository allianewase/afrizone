# Two different local files, two different readers:
#   - .env        -> read by `npm run seed` only (plain Prisma Client, not the
#                     Workers app). The only thing it actually needs is
#                     DATABASE_URL.
#   - .dev.vars   -> read by `wrangler dev` (Workers has no .env support).
#                     Everything below except DATABASE_URL is a `.dev.vars`
#                     override; D1/R2 themselves are bindings declared in
#                     wrangler.jsonc, emulated locally automatically.
# Both files are gitignored; copy whichever values you need into each.

# Local SQLite file `npm run seed` writes demo data into, before also
# applying it to wrangler dev's local D1 emulation - see prisma/seed.ts.
DATABASE_URL="file:./dev.db"

# Dev-only default. In production the server refuses to start unless this is
# set to something else. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-secret-change-me

# Comma-separated list of allowed CORS origins (web-admin, mobile web preview,
# any deployed frontend).
#
# UNCOMMENT THIS FOR LOCAL DEVELOPMENT - the code's localhost default does not
# apply here. wrangler.jsonc declares CORS_ORIGIN in `vars`, and vars apply to
# `wrangler dev` just as they do to a deploy, so a local API is configured with
# the PRODUCTION origins unless this line overrides them. Without it the
# web-admin dev server (5173) and the Expo web preview (8081) are both refused
# by their own local backend.
CORS_ORIGIN=http://localhost:5173,http://localhost:8081,http://localhost:19006,http://localhost:4000

# Paystack payouts + platform funding: blank = SIMULATED mode (no real
# transfers/charges). Add your secret key to enable live Paystack transfers on
# withdrawals and live hosted-checkout for admin platform funding.
PAYSTACK_SECRET=
PAYSTACK_BASE=https://api.paystack.co
# Where admin funding checkout redirects back to after payment (web-admin origin).
WEB_ADMIN_URL=http://localhost:5173

# SMS (worker OTP): blank = sim mode (devCode returned, master 123456 in dev)
SMS_PROVIDER=          # termii | twilio | (blank)
TERMII_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Google SSO (admin web + worker mobile): blank = SSO disabled (button shows a
# clear message, POST /api/auth/google returns 503). The backend must list EVERY
# OAuth client id used by any app as an allowed audience, because each app's
# token carries a different `aud`:
#   GOOGLE_WEB_CLIENT_ID     -> web-admin (browser) + backend audience
#   GOOGLE_IOS_CLIENT_ID     -> mobile on iOS
#   GOOGLE_ANDROID_CLIENT_ID -> mobile on Android
#   GOOGLE_EXPO_CLIENT_ID    -> mobile via Expo Go / web (expo-auth-session)
# See ../GOOGLE_SETUP.md for which Client ID goes where.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_EXPO_CLIENT_ID=
# GOOGLE_CLIENT_ID still works as an alias for the web client id (back-compat).
# GOOGLE_CLIENT_ID=
# Optional: comma-separated list of any additional allowed audiences.
# GOOGLE_CLIENT_IDS=
# Email (password reset / OTP email): blank = devToken returned, link logged
SMTP_URL=

# Smile ID Document Verification (ID + selfie): blank = KYC relies on manual
# admin review only (the pre-existing behaviour). See ../SMILE_SETUP.md.
SMILE_PARTNER_ID=
SMILE_API_KEY=
SMILE_SID_SERVER=0
# Optional: public URL for POST /api/webhooks/smile to receive human-review
# updates. Without it, only the synchronous (non-final) result is available.
# SMILE_CALLBACK_URL=

# AfriZoneMart inbound event bus: the shared secret Mart signs each event with
# (HMAC-SHA256 over "{timestamp}.{rawBody}"). Blank means every inbound event is
# refused with a 401 - which is the intended state until Mart has the secret, not
# a fault. See ../MART_INTEGRATION.md 2. In production set it with
# `wrangler secret put MART_INBOUND_SECRET`, never in wrangler.jsonc vars.
MART_INBOUND_SECRET=
