{
  "name": "afrizone-server",
  "version": "1.0.0",
  "description": "Afrizone Part Time — gig platform backend (Express + Prisma + SQLite)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node-dev --transpile-only prisma/seed.ts",
    "prisma:push": "prisma db push",
    "prisma:generate": "prisma generate",
    "setup": "prisma generate && prisma db push && npm run seed",
    "db:use-postgres": "node prisma/use-postgres.js",
    "db:use-sqlite": "node prisma/use-sqlite.js",
    "db:start": "node scripts/dev-db.js",
    "setup:prod": "node prisma/use-postgres.js && prisma generate && prisma migrate deploy"
  },
  "prisma": {
    "seed": "ts-node-dev --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1077.0",
    "@aws-sdk/s3-request-presigner": "^3.1077.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "smile-identity-core": "^3.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.17.9",
    "@types/qrcode": "^1.5.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
