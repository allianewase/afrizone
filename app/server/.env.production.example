# ─────────────────────────────────────────────────────────────────────────
# Afrizone API: production secrets for Cloudflare Workers.
#
# These are NOT loaded from a .env file in production - Workers has no
# concept of that. Set each one with:
#   npx wrangler secret put <NAME>
# or via the dashboard: Workers & Pages -> afrizone-api -> Settings ->
# Variables and Secrets -> add as type "Secret" (encrypted), not plaintext.
#
# Non-secret config (CORS_ORIGIN, WEB_ADMIN_URL) lives in wrangler.jsonc's
# checked-in "vars" block instead, not here - see that file. Database (D1)
# and file storage (R2) are bindings declared in wrangler.jsonc too; there's
# no DATABASE_URL or S3_*/AWS_* to set, unlike the old Railway/S3 setup this
# file used to document.
#
# Anything marked (optional) can be left unset; the feature just runs
# simulated/disabled instead of failing.
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Server refuses to boot in production without a real value here.
JWT_SECRET=

# ── Paystack payouts + funding (optional: blank = simulated, no real money) ──
PAYSTACK_SECRET=
PAYSTACK_BASE=https://api.paystack.co

# ── SMS / worker OTP (optional: blank = sim mode, devCode + master 123456) ──
SMS_PROVIDER=
TERMII_API_KEY=
TERMII_BASE=
TERMII_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Google SSO (optional: blank = SSO disabled, button shows a message) ──
# Every client id that will call the API needs to be listed (web, iOS,
# Android, Expo each carry a different `aud` in their token).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_EXPO_CLIENT_ID=
# GOOGLE_CLIENT_IDS=comma,separated,extra,audiences

# ── Email / password reset (optional: blank = devToken logged, no email sent) ──
SMTP_URL=

# ── Smile ID document verification (optional: blank = manual admin review only) ──
SMILE_PARTNER_ID=
SMILE_API_KEY=
SMILE_SID_SERVER=0
SMILE_CALLBACK_URL=

# ── 2FA app label shown in authenticator apps (optional) ──
TOTP_ISSUER=Afrizone
