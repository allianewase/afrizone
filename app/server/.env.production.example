# ─────────────────────────────────────────────────────────────────────────
# Afrizone API — production env vars for Railway
# Copy each of these into Railway → your service → Variables.
# Anything marked (optional) can be left unset; the feature just runs
# simulated/disabled instead of failing.
# ─────────────────────────────────────────────────────────────────────────

# Railway sets PORT itself — leave this unset unless you need to override it.
# PORT=4000

NODE_ENV=production

# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Server refuses to boot in production without a real value here.
JWT_SECRET=

# REQUIRED. Railway's Postgres plugin injects its own DATABASE_URL — copy
# THAT value here (or reference it directly if Railway lets you link vars),
# just make sure `?schema=public` is present:
# postgresql://user:password@host:5432/railway?schema=public
DATABASE_URL=

# REQUIRED. The web-admin production origin(s), comma-separated. Add
# localhost origins too only if you still want local dev to hit this
# deployed API (usually not necessary).
CORS_ORIGIN=https://admin.afrizonemart.com

# REQUIRED for Paystack platform-funding checkout redirects.
WEB_ADMIN_URL=https://admin.afrizonemart.com

# ── Paystack payouts + funding (optional — blank = simulated, no real money) ──
PAYSTACK_SECRET=
PAYSTACK_BASE=https://api.paystack.co

# ── SMS / worker OTP (optional — blank = sim mode, devCode + master 123456) ──
SMS_PROVIDER=
TERMII_API_KEY=
TERMII_BASE=
TERMII_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Google SSO (optional — blank = SSO disabled, button shows a message) ──
# Every client id that will call the API needs to be listed (web, iOS,
# Android, Expo each carry a different `aud` in their token).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_EXPO_CLIENT_ID=
# GOOGLE_CLIENT_IDS=comma,separated,extra,audiences

# ── Email / password reset (optional — blank = devToken logged, no email sent) ──
SMTP_URL=

# ── Smile ID document verification (optional — blank = manual admin review only) ──
SMILE_PARTNER_ID=
SMILE_API_KEY=
SMILE_SID_SERVER=0
SMILE_CALLBACK_URL=

# ── File storage (optional — blank = local disk inside the container, which
# does NOT persist across Railway redeploys; set S3 for real production use) ──
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_SIGNED_URL_EXPIRES=3600

# ── 2FA app label shown in authenticator apps (optional) ──
TOTP_ISSUER=Afrizone
